{
  "$schema": "https://raw.githubusercontent.com/nicehash/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "NetAmplify",
  "version": "1.0.0",
  "identifier": "com.netamplify.desktop",
  "build": {
    "frontendDist": "../apps/frontend/dist",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "pnpm dev:backend & pnpm dev:frontend",
    "beforeBuildCommand": "pnpm build:frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NetAmplify — Post once. Get seen everywhere.",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability", "cookie-capture-capability"]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "MIT License — NetAmplify 2026",
    "category": "SocialNetworking",
    "shortDescription": "One-click multi-platform posting for students",
    "longDescription": "NetAmplify lets students create a PostCard once and publish it to Reddit, Discord, Dev.to, Telegram, Bluesky, Hashnode, Mastodon, WordPress, X, and LinkedIn — with per-platform formatting, AES-256-GCM encrypted credentials, and zero-copy cookie capture via native WebView."
  }
}
