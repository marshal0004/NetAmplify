// /home/z/my-project/netamplify-app/libraries/nestjs-libraries/src/database/prisma/schema.prisma
// NetAmplify — Prisma schema (v2.0, Phase 2 rewrite).
//
// 9 models per docs/04-DATABASE.md:
//   User, Profile, PostCard, ProjectMedia, Connection, Post, PostTarget,
//   QuotaUsage, AuditLog
//
// 4 enums per docs/04-DATABASE.md:
//   Platform, ConnectionType, ConnectionStatus, PostTargetStatus
//
// Rules:
//   - credentialsCipher is the ONLY credential column; stores AES-256-GCM
//     ciphertext (JSON blob of tokens/keys). Plaintext exists only in-memory
//     inside TokenVault consumers (workers, connect validation).
//   - Every user-owned model has onDelete: Cascade from User, so account
//     deletion = single User.delete() → full GDPR-style wipe.
//   - Every user-scoped query MUST include `where: { userId: <session> }`
//     (enforced at the service layer; see 07-SECURITY-ACCESS.md §3).
//   - Migrations only via `prisma migrate dev --name <desc>`.
//
// This replaces postiz's 48-model schema entirely. Phase 2 also wipes the
// dev database (`prisma db push --force-reset`) since the old models are
// gone.

generator client {
  provider = "prisma-client-js"
  runtime = "nodejs"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

/// NetAmplify supports 8 platforms in MVP per docs/01-PRD.md §4:
///   Tier A (live): REDDIT, DISCORD, DEVTO, TELEGRAM, BLUESKY, HASHNODE
///   Tier B (bonus): TWITTER (X), LINKEDIN
enum Platform {
  REDDIT
  DISCORD
  DEVTO
  TELEGRAM
  BLUESKY
  HASHNODE
  TWITTER
  LINKEDIN
}

/// How the platform credential was obtained. Drives the Connect Checklist UX.
enum ConnectionType {
  OAUTH          /// Reddit, X, LinkedIn (OAuth 2.0 + PKCE)
  API_KEY        /// Dev.to, Hashnode (user-pasted)
  WEBHOOK        /// Discord (user-pasted webhook URL)
  BOT_TOKEN      /// Telegram (user-pasted bot token + channel)
  APP_PASSWORD   /// Bluesky (user-pasted app password)
}

/// Lifecycle of a single Connection row.
enum ConnectionStatus {
  ACTIVE     /// healthy, ready to publish
  REVOKED    /// platform-side revocation detected on publish; user must reconnect
  ERROR      /// transient error (rate-limit, network); auto-recovers
}

/// Lifecycle of a single PostTarget (one platform's attempt within a Post).
enum PostTargetStatus {
  QUEUED      /// job enqueued, worker not yet picked up
  PUBLISHING  /// worker is calling the platform API
  SUCCESS     /// published; platformPostUrl is set
  FAILED      /// permanent failure (exhausted retries); error is set
  SKIPPED     /// deliberately skipped (X quota, connection removed, etc.)
}

// ============================================================================
// Models
// ============================================================================

/// App account. Email + password (bcrypt ≥10). One User has one Profile,
/// many PostCards, many Connections, many Posts, many AuditLogs.
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile?
  postCards PostCard[]
  connections Connection[]
  posts Post[]
  auditLogs AuditLog[]

  @@index([email])
}

/// Student profile (college, grad year, links). One-to-one with User.
model Profile {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  headline String? @db.VarChar(140)
  college String?
  graduationYear Int?
  githubUrl String?
  portfolioUrl String?
  bio String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Canonical content — what the user creates once and Amplifies everywhere.
model PostCard {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String @db.VarChar(120)
  summary String @db.VarChar(200)
  description String @db.Text // markdown, ≤5000 enforced by Zod
  techStack String[] // 1–10 tags
  repoUrl String?
  liveUrl String?
  imageUrl String? // MVP: ≤1 image per PostCard

  media ProjectMedia[]
  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

/// Optional media attached to a PostCard. MVP allows 0–5 images per card
/// per docs/02-SRS.md FR-004 (we tightened this to "1 image" in the locked
/// docs; this table supports both shapes — the service layer enforces the
/// limit).
model ProjectMedia {
  id String @id @default(cuid())
  postCardId String
  postCard PostCard @relation(fields: [postCardId], references: [id], onDelete: Cascade)

  url String
  publicId String @unique // Cloudinary public id or local filename
  position Int @default(0)
  createdAt DateTime @default(now())

  @@index([postCardId])
}

/// One user's linked credential for one platform. credentialsCipher is
/// the ONLY credential column — AES-256-GCM ciphertext, JSON-encoded.
/// Plaintext exists only in-memory inside TokenVault consumers.
model Connection {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform Platform
  type ConnectionType
  platformAccountId String // stable identity id when available
  platformUsername String? // display handle e.g. "@yourname"

  credentialsCipher String @db.Text // AES-256-GCM JSON blob — ONLY ciphertext
  scopes String[] // [] for non-OAuth

  status ConnectionStatus @default(ACTIVE)
  lastUsedAt DateTime?
  lastValidatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, platform]) // one connection per platform per user
  @@index([userId, status])
}

/// A single Amplify action — one PostCard published to N platforms.
/// Creates one PostTarget per platform. requestId is the client-side
/// idempotency key (prevents double-publish on retry/double-click).
model Post {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  postCardId String
  postCard PostCard @relation(fields: [postCardId], references: [id], onDelete: Cascade)

  requestId String? @unique // client idempotency key

  targets PostTarget[]
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([postCardId])
}

/// One platform's attempt within a Post. Independent lifecycle from
/// sibling targets (partial success allowed per FR-012).
model PostTarget {
  id String @id @default(cuid())
  postId String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  platform Platform
  connectionId String? // null if disconnected before execution

  status PostTargetStatus @default(QUEUED)
  options Json? // e.g., { subreddit: "sideproject" } for Reddit

  platformPostUrl String?
  platformPostId String?

  error String? @db.Text // sanitized platform message (no creds)
  errorClass String? // AUTH | RATE | VALIDATION | NETWORK | QUOTA

  attempts Int @default(0)
  publishedAt DateTime?
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([status])
}

/// X (Twitter) monthly post budget guard per FR-018.
/// Counter per platform per calendar month — default budget 450
/// (under X free tier's 1500 cap, leaves headroom for manual posts).
model QuotaUsage {
  id String @id @default(cuid())
  platform Platform
  yearMonth String // "2026-09" (YYYY-MM)
  used Int @default(0)

  @@unique([platform, yearMonth])
  @@index([platform])
}

/// Security audit trail. NEVER stores credentials or decrypted content.
/// One row per: LOGIN, LOGIN_FAIL, CONNECT, DISCONNECT, PUBLISH, RETRY,
/// TOKEN_FAIL, ACCOUNT_DELETE.
model AuditLog {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  action String // LOGIN | LOGIN_FAIL | CONNECT | DISCONNECT | PUBLISH | RETRY | TOKEN_FAIL | ACCOUNT_DELETE
  platform String?
  ip String?
  userAgent String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}
